#!/usr/bin/env bash
# widefield_pipeline pre-push — run the test suite before a push reaches main.
#
# Both machines push main directly and rebase (CLAUDE.md rule 4), so a broken push blocks the
# OTHER machine's rebase — that is what this gate is for, and it is why it runs the WHOLE
# suite rather than a fast subset.
#
# IT TAKES ~2.5 MINUTES (2,400 tests, measured 2026-09-22). This comment said "~2 s" until
# then, which was true when the hook was written in August and had not been rechecked since.
# The number is stated here because a gate whose cost is understated is a gate people learn
# to pass with --no-verify. Roughly 60% of it is five cluster-permutation tests and one deck
# test; if the wait ever stops being worth it, deselect THOSE by name rather than trimming
# the suite blindly.
#
# Enable once per clone:  bash scripts/setup-hooks.sh
# Bypass once (emergency): git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. .githooks/_find_python.sh

# Interpreter search is shared with pre-commit; see `.githooks/_find_python.sh` for why a bare
# `python` is not trusted. If nothing with pytest is found, BLOCK rather than skip the tests.
if ! find_python pytest; then
  cat >&2 <<EOF
pre-push: no python with pytest found (tried CONDA_PREFIX, .venv, the locanmf env, PATH).
  Activate the env, or export CONDA_PREFIX, e.g.:
    export CONDA_PREFIX=C:/Users/sabatini/.conda/envs/locanmf   # analysis box
  Emergency bypass: git push --no-verify
EOF
  exit 1
fi

echo "pre-push: pytest -q [$PY] — about 2.5 minutes…" >&2
"$PY" -m pytest -q
