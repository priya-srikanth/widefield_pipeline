#!/usr/bin/env bash
# widefield_pipeline pre-push — run the tests a push touches before it reaches main.
#
# Both machines push main directly and rebase (CLAUDE.md rule 4), so a broken push blocks the
# OTHER machine's rebase — that is what this gate is for. It ran the WHOLE suite until 2026-10-30;
# it now runs only the test files the push touches (see below), and the whole suite for shared config.
#
# IT TAKES ~11 MINUTES (3,235 tests, measured 2026-10-19; ~2.5 min at 2,400 tests on 2026-09-22). This comment said "~2 s" until
# then, which was true when the hook was written in August and had not been rechecked since.
# The number is stated here because a gate whose cost is understated is a gate people learn
# to pass with --no-verify. Roughly 60% of it is five cluster-permutation tests and one deck
# test; if the wait ever stops being worth it, deselect THOSE by name rather than trimming
# the suite blindly.
#
# Enable once per clone:  bash scripts/setup-hooks.sh
# Bypass once (emergency): git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# DOCS-ONLY PUSHES SKIP THE SUITE (Priya, 2026-10-19). If every file changed by the commits being pushed is a
# `.md`, nothing a test can see has changed (no test reads a Markdown file -- checked 2026-10-19; if one ever
# does, drop this block). ANY other file, a new branch, or a range git cannot resolve runs the full suite.
# The suite now takes ~11 min (3,235 tests, 2026-10-19), and about half of the pushes are handoff / doc updates.
docs_only=1
full=0
changed=""
zero=0000000000000000000000000000000000000000
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                               # a branch delete changes nothing
  if [ "$rsha" = "$zero" ]; then docs_only=0; full=1; break; fi   # new remote branch: no base to diff
  files=$(git diff --name-only "$rsha" "$lsha" 2>/dev/null) || { docs_only=0; full=1; break; }
  changed="$changed"$'\n'"$files"
  if [ -n "$(printf '%s\n' "$files" | grep -v '\.md$' | grep -v '^$' || true)" ]; then docs_only=0; fi
done
if [ "$docs_only" = 1 ]; then
  echo "pre-push: only .md files changed -- tests skipped" >&2
  exit 0
fi

# ONLY THE TESTS THE PUSH TOUCHES (Priya, 2026-10-30: "can we test only the ones we change"; the full suite had
# passed 15 min). Selected: changed test files, plus every test file that imports a changed .py module (by its
# stem: `wfield_local.<m>`, `from wfield_local import ... <m>`, `import <m>` / `from <m> import` for scripts on
# sys.path, or `<m>.py` loaded by path). Indirect imports are NOT followed -- a change to a helper that a test
# reaches only through another module is not tested here. Full suite: configs/, conftest.py, pyproject.toml, the
# hooks, a new branch, or WIDEFIELD_PREPUSH_FULL=1 (run it that way after a change to shared code).
[ "${WIDEFIELD_PREPUSH_FULL:-0}" = 1 ] && full=1
changed=$(printf '%s\n' "$changed" | grep -v '^$' | sort -u || true)
if printf '%s\n' "$changed" | grep -qE '^(configs/|conftest\.py$|tests/conftest\.py$|pyproject\.toml$|\.githooks/)'; then
  full=1
fi
targets=""
if [ "$full" = 0 ]; then
  for f in $(printf '%s\n' "$changed" | grep '\.py$' || true); do
    if [[ "$f" == tests/* ]]; then
      [ -f "$f" ] && targets="$targets"$'\n'"$f"
      continue
    fi
    m=$(basename "$f" .py)
    [ "$m" = "__init__" ] && continue
    hits=$(grep -rlE "wfield_local\.$m\b|from wfield_local import .*\b$m\b|^\s*(from|import) $m\b|\b$m\.py\b" \
           tests --include='*.py' 2>/dev/null || true)
    [ -n "$hits" ] && targets="$targets"$'\n'"$hits"
  done
  targets=$(printf '%s\n' "$targets" | grep -v '^$' | sort -u || true)
  if [ -z "$targets" ]; then
    echo "pre-push: no test imports a changed file -- tests skipped (WIDEFIELD_PREPUSH_FULL=1 for the suite)" >&2
    exit 0
  fi
fi

. .githooks/_find_python.sh

# Interpreter search is shared with pre-commit; see `.githooks/_find_python.sh` for why a bare
# `python` is not trusted. If nothing with pytest is found, BLOCK rather than skip the tests.
if ! find_python pytest; then
  cat >&2 <<EOF
pre-push: no python with pytest found (tried CONDA_PREFIX, .venv, the locanmf env, PATH).
  Activate the env, or export CONDA_PREFIX, e.g.:
    export CONDA_PREFIX=C:/Users/sabatini/.conda/envs/locanmf   # analysis box
  Emergency bypass: git push --no-verify
EOF
  exit 1
fi

if [ "$full" = 1 ]; then
  echo "pre-push: FULL pytest -q [$PY] — 15+ minutes…" >&2
  "$PY" -m pytest -q
else
  echo "pre-push: pytest on $(printf '%s\n' "$targets" | wc -l | tr -d ' ') test file(s) touched by this push:" >&2
  printf '  %s\n' $targets >&2
  # shellcheck disable=SC2086
  "$PY" -m pytest -q $targets
fi
