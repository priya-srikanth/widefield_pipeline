#!/usr/bin/env bash
# widefield_pipeline pre-commit — lint the STAGED Python with ruff.
#
# Quality gate only: this repo's workflow is direct-to-main on both machines (CLAUDE.md rule 4),
# so — unlike stroke_orofacial — there is NO branch protection here. Incremental (staged files
# only), so pre-existing issues in files you didn't touch never block you.
#
# Enable once per clone:  bash scripts/setup-hooks.sh   (sets core.hooksPath = .githooks)
# Bypass once:            git commit --no-verify
set -euo pipefail

# Interpreter: prefer the active conda env (CONDA_PREFIX) — a bare `python` in Git Bash can resolve
# to the Windows App Store shim, which has neither ruff nor pytest (see the pre-push note).
PY="python"
if [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/python.exe" ]; then
  PY="$CONDA_PREFIX/python.exe"
fi

# Staged Python files (added/copied/modified), NUL-safe.
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')
[ ${#FILES[@]} -eq 0 ] && exit 0

if ! "$PY" -m ruff --version >/dev/null 2>&1; then
  echo "pre-commit: ruff not installed ('pip install -e .[dev]') — skipping lint." >&2
  exit 0
fi

echo "pre-commit: ruff check on ${#FILES[@]} staged Python file(s)…" >&2
"$PY" -m ruff check "${FILES[@]}"
