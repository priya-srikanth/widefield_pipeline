#!/usr/bin/env bash
# widefield_pipeline pre-commit — lint the STAGED Python with ruff.
#
# Quality gate only: this repo's workflow is direct-to-main on both machines (CLAUDE.md rule 4),
# so — unlike stroke_orofacial — there is NO branch protection here. Incremental (staged files
# only), so pre-existing issues in files you didn't touch never block you. The rule set is chosen
# in `pyproject.toml` under [tool.ruff.lint]; read the comment there before widening it.
#
# Enable once per clone:  bash scripts/setup-hooks.sh   (sets core.hooksPath = .githooks)
# Bypass once:            git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. .githooks/_find_python.sh

# Staged Python files (added/copied/modified), NUL-safe.
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')
[ ${#FILES[@]} -eq 0 ] && exit 0

# BLOCK RATHER THAN SKIP when ruff cannot be found. This used to print a warning and exit 0, so
# in any shell without CONDA_PREFIX the gate silently did nothing — which is how the first commit
# after enabling these hooks went through unlinted. pre-push already blocks in this situation;
# the two now agree.
if ! find_python ruff; then
  cat >&2 <<EOF
pre-commit: no python with ruff found (tried CONDA_PREFIX, .venv, the locanmf env, PATH).
  Install it:  pip install -e .[dev]
  or point at the env:  export CONDA_PREFIX=C:/Users/<you>/miniconda3/envs/locanmf
  Deliberate bypass:    git commit --no-verify
EOF
  exit 1
fi

echo "pre-commit: ruff check on ${#FILES[@]} staged Python file(s) [$PY]…" >&2
"$PY" -m ruff check "${FILES[@]}"
